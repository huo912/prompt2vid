# ============================================================
# prompt2vid 环境变量示例
# 复制为 .env 并按需修改：cp .env.example .env
#
# 多 GPU 档位：项目根目录提供三份完整档位配置（各含模型清单与下载命令）：
#   .env.4060   本地 4060（8GB）：SDXL Base + LTX 2B + 动漫滑块 LoRA，约 13.9GB
#   .env.4090   云机 4090（24GB）：RealVisXL + LTX 13B fp8 + 双 LoRA，约 31.8GB
#   .env.5090   云机 5090（32GB）：同 4090 模型，T5 上 GPU、可上 720p
# 切换方式（三选一，本文件仅是不指定时的默认模板）：
#   prompt2vid --env-file .env.4090 "描述"     # 简名 --env-file 4090 亦可
#   PROMPT2VID_ENV_FILE=.env.4090               # 环境变量（server/k8s 用）
#   PROMPT2VID_PROFILE=4090                     # 环境变量（档位简名）
# ============================================================

# --- LLM（CrewAI 全部 Agent 共用的模型，OpenAI 兼容格式）---
# 模型名使用 litellm 前缀格式，例如：
#   openai/gpt-4o-mini / openai/gpt-4o / deepseek/deepseek-chat / anthropic/claude-sonnet-4-20250514
PROMPT2VID_MODEL=openai/gpt-4o-mini
# OpenAI 兼容网关地址（可选；内网 LLM 网关 / one-api / vllm 等）
PROMPT2VID_LLM_BASE_URL=
PROMPT2VID_LLM_API_KEY=sk-xxxx
PROMPT2VID_LLM_TEMPERATURE=0.7
# 可选：为单个 Agent 覆盖模型（Agent 名大写，点换双下划线）
# PROMPT2VID_MODEL__SCRIPT_WRITER=openai/gpt-4o
# PROMPT2VID_MODEL__VIDEO_GENERATOR=openai/gpt-4o-mini

# --- ComfyUI ---
# 本地运行默认 http://127.0.0.1:8188；k8s 内用 http://comfyui.comfyui.svc.cluster.local:8188
COMFYUI_URL=http://127.0.0.1:8188
# 文生图 checkpoint（位于 ComfyUI models/checkpoints/）
# 名字必须与服务端一致；不一致时客户端会自动降级到同类 SDXL 模型并告警
COMFYUI_T2I_CHECKPOINT=sd_xl_base_1.0.safetensors
# 首帧画幅（竖屏 4:7）。视频分辨率会跟随首帧自动换算成 32 的倍数，
# 不要再把视频固定成 512x768，否则人物会被裁切/挤压变形。
COMFYUI_T2I_WIDTH=768
COMFYUI_T2I_HEIGHT=1344
# LTX-Video checkpoint（位于 ComfyUI models/checkpoints/）
# 8-12GB 显存：ltx-video-2b-v0.9.5.safetensors
# 24-32GB（5090/4090）：ltxv-13b-0.9.7-distilled-fp8.safetensors（质量最好）
COMFYUI_LTX_CHECKPOINT=ltx-video-2b-v0.9.5.safetensors
# LTX 单帧像素预算（自动换算分辨率用）：
#   2B / 8-12GB   → 393216（约 512x768，默认）
#   13B / 24-32GB → 589824（约 576x1024，按模型自动选择）
#   720p          → 921600（约 704x1248，显存吃紧时回调）
# COMFYUI_LTX_MAX_PIXELS=589824
# 需要固定画幅时才设置（两者必须同时给，会被取整到 32 的倍数）
# COMFYUI_LTX_WIDTH=
# COMFYUI_LTX_HEIGHT=
# LTX 文本编码器（位于 ComfyUI models/text_encoders/，8G 显存请用 fp8 版本）
COMFYUI_T5=t5xxl_fp8_e4m3fn.safetensors
# T5 放 CPU 可进一步省显存（default / cpu）
COMFYUI_T5_DEVICE=cpu
# 单次生成最长等待秒数
COMFYUI_TIMEOUT=1800
# 单镜生成失败重试次数（按批次重试）
COMFYUI_RETRIES=2
# 采样步数：SDXL 默认 25（dpmpp_2m）。
# LTX 留空即可按模型自动选择：distilled → cfg 1.0 / 8 步；
# 13B dev → cfg 3.0 / 30 步；2B 0.9.5 → cfg 3.0 / 10 步。
COMFYUI_T2I_STEPS=25
# COMFYUI_LTX_STEPS=
# COMFYUI_LTX_CFG=
# LTX 正向提示词追加的肢体稳定约束（留空可关闭）
# COMFYUI_LTX_PROMPT_SUFFIX=consistent anatomy, natural body proportions, stable limbs, detailed hands
# LTX 输出帧率与单镜帧数上限（帧数自动换算并满足 8n+1 约束）
COMFYUI_LTX_FPS=25
COMFYUI_LTX_MAX_FRAMES=121
# 固定种子可复现（设为整数；逐镜自动 +1；不设则随机）
# PROMPT2VID_SEED=
# 文生图负向提示词（可选覆盖）
COMFYUI_NEGATIVE_PROMPT=
# LTX 负向提示词（可选覆盖）
COMFYUI_LTX_NEGATIVE_PROMPT=

# --- 固定风格（全片统一，PROMPT2VID_STYLE）---
# 预设：anime（动漫）/ realistic（写实）；设为其它非空值时按字面英文
# 提示词追加（自定义风格）；留空关闭。
# 生效范围（两层硬约束）：分镜 LLM 的画面描述（plan_storyboard 任务
# 注入风格约束）+ 每镜文生图/图生视频的正负向提示词（自动追加风格词
# 与风格排斥词）——LLM 忘写风格词也不会跑偏。
PROMPT2VID_STYLE=anime

# --- 风格 LoRA（可选，与 PROMPT2VID_STYLE 叠加）---
# 文生图 LoRA（位于 ComfyUI models/loras/）。文件缺失时自动降级为
# 无 LoRA 生成（只靠提示词风格约束），流水线不中断。
# 各显卡档位推荐（下载命令见对应 .env.<档位> 头部模型清单）：
#   4060（8GB，SDXL Base）：anime.safetensors（ntc-ai/SDXL-LoRA-slider.anime，
#     SDXL Base 官方同源动漫滑块，48MB；滑块权重建议 1.0-2.0）
#   4090/5090（RealVisXL）：同上滑块可复用；追求更纯动漫风可把
#     COMFYUI_T2I_CHECKPOINT 换成动漫原生 SDXL（如 animagine-xl-3.1.safetensors）
#   视频侧 LTX LoRA（COMFYUI_LTX_LORA）：LTX 2B 无现成动漫 LoRA（留空）；
#     13B 档推荐 shinkai-anime-style-lora-v1_58000.safetensors
#     （Cseti/ltxv-13b-shinkai-anime-style-lora-v1，812MB，新海诚风格）
COMFYUI_T2I_LORA=anime.safetensors
COMFYUI_T2I_LORA_STRENGTH=1.5
# COMFYUI_LTX_LORA=shinkai-anime-style-lora-v1_58000.safetensors
# COMFYUI_LTX_LORA_STRENGTH=0.8
# --- 角色一致性（IPAdapter 参考图注入，可选）---
# true 时：分镜表定义了 characters 的运行会先为每个角色生成一张定妆照
# （frames/character_ref_<id>.png），出镜分镜的首帧生成注入该参考，
# 全片角色长相一致。需 ComfyUI 安装 ComfyUI_IPAdapter_plus 自定义节点
# 与对应模型（见 docs/LOCAL_SETUP.md 第 6 节）；未安装时相关分镜自动
# 回退为无参考生成，流水线不中断。
# COMFYUI_IPADAPTER=true
# IPAdapterUnifiedLoader 预设（默认 PLUS FACE (portraits)，只需
# ip-adapter-plus-face_sdxl + CLIP-ViT-H 两个模型；FACEID 系列身份
# 保持更强但需 insightface）
# COMFYUI_IPADAPTER_PRESET=PLUS FACE (portraits)
# 参考注入权重 0.0-1.0（越高越像定妆照，过高会压制构图）
# COMFYUI_IPADAPTER_WEIGHT=0.8

# --- 执行模式 ---
# true 时 LLM 只做创意三阶段（需求/剧本/分镜）+ 发布，媒体阶段由代码直跑
# （省 6 次 LLM 往返，更快更省 token）；CLI 可用 --direct-media / --no-direct-media 覆盖
# PROMPT2VID_DIRECT_MEDIA=

# --- 剪辑（可选）---
# 背景音乐（指向音频文件时启用，循环低音量混入）
# PROMPT2VID_BGM=
# BGM 音量（默认 0.25）
# PROMPT2VID_BGM_VOLUME=0.25
# 字幕烧录样式（libass force_style 语法）
# PROMPT2VID_SUBTITLE_STYLE=FontSize=18,Outline=1,MarginV=40

# --- 配音（TTS）---
# edge-tts 需要公网访问 speech.platform.bing.com；公司网络拦截时自动回退：
# 1) PROMPT2VID_TTS_BASE_URL 指定的 OpenAI 兼容 /audio/speech 网关（可选）
# 2) 静音占位音频（流水线不中断）
# PROMPT2VID_TTS_BASE_URL=
# PROMPT2VID_TTS_MODEL=tts-1
# PROMPT2VID_TTS_VOICE=alloy
# PROMPT2VID_TTS_API_KEY=
# edge-tts 音色与语速（默认 zh-CN-XiaoxiaoNeural / +0%）
# EDGE_TTS_VOICE=
# EDGE_TTS_RATE=

# --- 抖音开放平台 ---
# 未申请到凭据前保持 true：只记录 .douyin/state.json，不真实上传
DOUYIN_DRY_RUN=true
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 用户授权 access_token（发布视频需要）
DOUYIN_ACCESS_TOKEN=

# --- 运行目录（可选）---
# 不设置时默认为 ./output/run_<时间戳>
# PROMPT2VID_WORKSPACE=
# config 目录不设置时按 ./config -> 源码仓库 config 顺序查找
# PROMPT2VID_CONFIG_DIR=
